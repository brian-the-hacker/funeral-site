# Copy to .env and fill in. NEVER commit .env or share the secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=makueni-pamoja

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./site.db
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,https://www.makuenipamojafuneralhome.co.ke

# Optional: email the owner when someone uses the contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=m.pamoja2019@gmail.com
